# Kong 3.9.2 - RPM Based Image (Amazon Linux 2023)
#
# Build instructions:
#   docker buildx build --platform linux/amd64,linux/arm64 -f Dockerfile.rpm -t kong-rpm:3.9.2 .

# Stage 1: Base with security updates
FROM amazonlinux:2023 AS secure-base

RUN dnf update -y && \
    dnf install -y \
    curl \
    ca-certificates \
    wget \
    shadow-utils && \
    dnf clean all && \
    rm -rf /var/cache/dnf

# Stage 2: Kong installation from local .rpm
FROM secure-base AS kong-install

ARG TARGETARCH

# Dependencies for Kong
RUN dnf install -y \
    perl \
    perl-Time-HiRes \
    zlib \
    zlib-devel \
    pcre2 \
    openssl \
    hostname \
    tar \
    gzip && \
    dnf clean all

# Create kong user
RUN groupadd --gid 1000 kong && \
    useradd --uid 1000 --gid kong --no-create-home kong

# Copy and install local .rpm
# Expected filenames in output/: 
#   kong-3.9.2-openresty1.31.1.1.amd64.rpm
#   kong-3.9.2-openresty1.31.1.1.arm64.rpm
COPY output/kong-3.9.2-openresty1.31.1.1.${TARGETARCH}.rpm /tmp/kong.rpm

# RPM installation usually handles dependencies but we install them explicitly above to be safe.
# We use --nodeps if we want to bypass the 'pcre' vs 'pcre2' naming issue if it arises,
# but 'dnf install' is better.
RUN dnf install -y /tmp/kong.rpm && \
    rm -rf /tmp/kong.rpm && \
    dnf clean all

# Create symlinks (matching the Debian Dockerfile pattern)
RUN ln -sf /usr/local/openresty/bin/resty /usr/local/bin/resty && \
    ln -sf /usr/local/openresty/luajit/bin/luajit /usr/local/bin/luajit && \
    ln -sf /usr/local/openresty/luajit/bin/luajit /usr/local/bin/lua && \
    ln -sf /usr/local/openresty/nginx/sbin/nginx /usr/local/bin/nginx

COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

RUN chown kong:0 /usr/local/bin/kong && \
    chown -R kong:0 /usr/local/kong && \
    chown kong:0 /docker-entrypoint.sh

# Final stage: clean runtime image
FROM secure-base AS runtime

RUN dnf install -y \
    perl \
    perl-Time-HiRes \
    zlib \
    pcre2 \
    openssl && \
    dnf clean all && \
    rm -rf /var/cache/dnf

COPY --from=kong-install /usr/local /usr/local
COPY --from=kong-install /etc/kong /etc/kong
COPY --from=kong-install /docker-entrypoint.sh /docker-entrypoint.sh
COPY --from=kong-install /etc/passwd /etc/passwd
COPY --from=kong-install /etc/group /etc/group
COPY --from=kong-install /etc/shadow /etc/shadow

RUN chown kong:0 /usr/local/bin/kong && \
    chown -R kong:0 /usr/local/kong && \
    chown kong:0 /docker-entrypoint.sh && \
    chmod 755 /docker-entrypoint.sh

RUN mkdir -p /usr/local/kong/declarative && \
    chown -R kong:0 /usr/local/kong

EXPOSE 8000 8001 8443 8444

HEALTHCHECK --interval=10s --timeout=10s --retries=10 \
  CMD kong health || exit 1

USER kong
WORKDIR /usr/local/kong

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["kong", "docker-start"]

LABEL maintainer="Kong Docker Maintainers <suriya.ruk@dome.cloud>" \
      org.opencontainers.image.title="Kong Gateway OSS (RPM)" \
      org.opencontainers.image.version="3.9.2" \
      org.opencontainers.image.description="Kong Gateway 3.9.2 based on Amazon Linux 2023" \
      security.patched="true"
